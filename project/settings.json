{
  "schema_version": 2,
  "name": "Kanban Rememory",
  "modules": [
    "misc",
    "notifications",
    "orchestrator"
  ],
  "workflow": {
    "stages": [
      "backlog",
      "development",
      "completion",
      "cancellation"
    ],
    "active": [
      "development"
    ],
    "completed": "completion",
    "wip_limit": 1,
    "timezone": "Europe/Paris",
    "transitions": {
      "backlog": [
        "development",
        "cancellation"
      ],
      "development": [
        "completion",
        "cancellation"
      ]
    }
  },
  "version": "0.1.0"
}
