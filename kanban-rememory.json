        "cancellation"
      ]
    }
  },
  "version": "0.2.0",
  "kit": "0.1.0",
  "notifications": {
    "slack": {
      "configured": true,
      "active": true
    },
    "telegram": {
      "configured": true,
      "active": false
    }
  }
